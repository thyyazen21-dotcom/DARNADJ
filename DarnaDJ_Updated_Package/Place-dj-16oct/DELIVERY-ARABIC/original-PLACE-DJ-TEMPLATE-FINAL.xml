<!-- ===== Homepage Hero ===== -->
<b:if cond='data:view.isHomepage'>
  <section class='hero'>
    <div class='container'>
      <div aria-label='صور مختارة من العقارات' class='hero-slider' id='hero-slider'>
        <div aria-label='صور مختارة من العقارات' class='hero-slides'>
          <article class='hero-slide is-active'><img alt='مشهد ساحلي في جيبوتي' fetchpriority='high' height='771' src='https://files.manuscdn.com/user_upload_by_module/session_file/...'/></article>
          <article class='hero-slide'><img alt='فيلا عصرية في جيبوتي' height='771' loading='lazy' src='https://files.manuscdn.com/user_upload_by_module/session_file/...'/></article>
          <article class='hero-slide'><img alt='استوديو مفروش في جيبوتي' height='771' loading='lazy' src='https://files.manuscdn.com/user_upload_by_module/session_file/...'/></article>
