  <b:skin><![CDATA[
  /* Variable Definitions
  ====================
  <Variable name="bg.color" description="خلفية الصفحة" type="color" default="#f3f7fa" value="#f3f7fa"/>
  <Variable name="card.bg" description="خلفية البطاقات" type="color" default="#ffffff" value="#ffffff"/>
  <Variable name="primary.color" description="اللون الأساسي" type="color" default="#084a72" value="#084a72"/>
  <Variable name="primary.dark" description="اللون الأساسي الداكن" type="color" default="#084a72" value="#084a72"/>
  <Variable name="accent.color" description="لون التمييز" type="color" default="#12AD2B" value="#12AD2B"/>
  <Variable name="text.color" description="لون النص" type="color" default="#1a1a1a" value="#1a1a1a"/>
  <Variable name="muted.color" description="لون النص الثانوي" type="color" default="#6b6b6b" value="#6b6b6b"/>
  <Variable name="border.color" description="لون الحدود" type="color" default="#dbe4ea" value="#dbe4ea"/>
  <Variable name="header.bg" description="خلفية الرأس" type="color" default="#0d6ea8" value="#0d6ea8"/>
  <Variable name="footer.bg" description="خلفية التذييل" type="color" default="#084a72" value="#084a72"/>
  <Variable name="whatsapp.color" description="لون واتساب" type="color" default="#12AD2B" value="#12AD2B"/>
  */

  /* ===== Reset & Base ===== */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body {
    font-family: system-ui, -apple-system, 'Segoe UI', Tahoma, Arial, sans-serif;
    background: $(bg.color);
    color: $(text.color);
    line-height: 1.55;
    font-size: clamp(16px, 1.15vw, 18px);
    overflow-x: hidden;
  }
  a { color: $(primary.color); text-decoration: none; transition: color .2s ease; }
  a:hover { color: $(primary.dark); }
  img { max-width: 100%; height: auto; display: block; }
  ul { list-style: none; }
  .visually-hidden { position:absolute !important; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0; }
  .skip-link { position:absolute; inset-inline-start:-9999px; top:0; background:$(primary.dark); color:#fff; padding:10px 16px; z-index:9999; border-radius:0 0 8px 0; }
  .skip-link:focus { inset-inline-start:0; }
  [hidden] { display: none !important; }

  /* ===== Unified container (Section 2) ===== */
  .container {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(14px, 4vw, 32px);
    box-sizing: border-box;
  }

  /* ===== Blogger Layout Editor isolation (body#layout) ===== */
  /* The Blogger layout editor must never inherit the visitor-facing layout rules. */
  body#layout {
    display: block !important;
    min-height: 0 !important;
    overflow: visible !important;
    background: #eef1f4 !important;
    color: #1a1a1a !important;
    font-family: Arial, Helvetica, sans-serif !important;
    padding: 0 !important;
  }
  body#layout #main-wrapper { display: block !important; flex: none !important; }
  body#layout .site-header,
  body#layout .site-footer,
  body#layout .search-bar,
  body#layout .nav-toggle,
  body#layout .main-nav,
  body#layout .skip-link { display: none !important; }
  body#layout .container { max-width: 100% !important; padding: 0 10px !important; }
  body#layout .main-content { display: block !important; padding: 10px 0 !important; }
  body#layout .content-area,
  body#layout .sidebar-area,
  body#layout .sidebar { display: block !important; width: auto !important; max-width: 100% !important; float: none !important; }
  body#layout .property-grid,
  body#layout .blog-posts,
  body#layout .blog-posts > .section,
  body#layout .post,
  body#layout .property-card { display: block !important; width: auto !important; max-width: 100% !important; }
  body#layout .section { margin: 10px 0 !important; }
  body#layout .section h2,
  body#layout .section h3 { font-size: 13px !important; }
  body#layout .widget { margin: 8px 0 !important; }
  body#layout .layout-title,
  body#layout .layout-widget-description { display: block !important; }

  /* ===== Header ===== */
  .site-header {
    background: $(header.bg);
    color: #fff;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 12px rgba(0,0,0,.12);
  }
  /* truncated for brevity */
  ]]></b:skin>

  <b:template-skin>
    <![CDATA[
    body { min-height: 100vh; display: flex; flex-direction: column; }
    #main-wrapper { flex: 1 0 auto; }
    body#layout { display: block !important; min-height: 0 !important; }
    ]]>
  </b:template-skin>
</head>

