<!-- PLACE-DJ final template repair: full-logo containment, icon-only social placeholders; protected search/filter/preferred-card logic unchanged. -->

<a class='skip-link' href='#main-content'>تخط&#1614;&#1617; إلى المحتوى</a>

<!-- ===== Header ===== -->
<header class='site-header'>
  <div class='container'>
    <div class='header-inner'>
      <a aria-label='Place-dj — الصفحة الرئيسية' class='site-logo' expr:href='data:blog.homepageUrl'>
        <span aria-hidden='true' class='logo-icon'>
          <img alt='' class='brand-logo' height='165' src='data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAASwAAAClCAYAAADmtcDRAABHpklEQVR42u19eXxlVZXut9be5w5JbmoMxTzJXIBIFaNIJSKgIAJqFWoLNna3U7c+pb[...]'/>
        </span>
      </a>
      <button aria-label='القائمة' class='nav-toggle' onclick='this.nextElementSibling.classList.toggle("open")' type='button'>&#9776;</button>
      <nav class='main-nav'>
        <a expr:href='data:blog.homepageUrl'>الرئيسية</a>
        <a expr:href='data:blog.homepageUrl + "search/label/شقة"'>شقق</a>
        <a expr:href='data:blog.homepageUrl + "search/label/فيلا"'>فلل</a>
        <a expr:href='data:blog.homepageUrl + "search/label/منزل"'>منازل</a>
        <a expr:href='data:blog.homepageUrl + "search/label/استوديو"'>استوديوهات</a>
        <a expr:href='data:blog.homepageUrl + "search/label/غرفة"'>غرف</a>
        <a expr:href='data:blog.homepageUrl + "p/contact.html"'>تواصل</a>
      </nav>
      <form aria-label='بحث شامل في كل المنشورات' class='search-bar' expr:action='data:blog.searchUrl' method='get' onsubmit='return darnaSubmitSearch(this);' role='search'>
        <input aria-label='بحث شامل' autocomplete='off' enterkeyhint='search' name='q' placeholder='ابحث في كل العقارات...' required='required' type='search'/>
        <button type='submit'>بحث</button>
      </form>
      <div class='header-tools'>
        <div aria-label='Language selector' class='lang-switch' role='group'>
          <a aria-current='page' aria-label='العربية' class='lang-link' data-lang='ar' href='https://www.place-dj.com' title='العربية'><svg aria-hidden='true' focusable='false'/>العربية</a>
          <a aria-label='English' class='lang-link' data-lang='en' href='https://en.place-dj.com' title='English'><svg aria-hidden='true' focusable='false'/>EN</a>
          <a aria-label='Français' class='lang-link' data-lang='fr' href='https://fr.place-dj.com' title='Français'><svg aria-hidden='true' focusable='false'/>FR</a>
        </div>
        <button aria-controls='favorites-panel' aria-expanded='false' aria-label='المفضلة' class='icon-btn' id='favorites-toggle' type='button'>
          <svg aria-hidden='true' fill='currentColor' height='18' viewBox='0 0 24 24' width='18'><path d='M12 21s-7-4.5-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6C19 16.5 12 21 12 21z'/></svg>
          <span class='fav-badge'>0</span>
        </button>
      </div>
    </div>
      <b:section class='navigation-layout' id='navigation-layout' maxwidgets='1' showaddelement='yes'/>
  </div>
</header>

<div id='main-wrapper'>


      <b:if cond='data:view.isHomepage'>
      <b:section class='header-widgets' id='header-widgets' maxwidgets='2' showaddelement='yes'>
        <b:widget id='HTML9' locked='false' title='رسالة الشريط العلوي' type='HTML' version='2' visible='true'>
