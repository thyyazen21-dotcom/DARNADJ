  <!-- Title: overrides the Blogger blog-title setting ("بلاس") with the Place-dj brand.
       NOTE: og:title on the homepage is emitted by all-head-content from the blog-title
       setting and cannot be overridden here without creating a duplicate tag; the owner
       should also set the blog title to "Place-dj" in Blogger Settings (external action). -->
  <b:if cond='data:view.isHomepage'>
    <title>Place-dj &#8212; منصة تأجير العقارات في جيبوتي</title>
  <b:else/>
    <title><data:view.title/> &#8212; Place-dj</title>
  </b:if>

  <b:if cond='data:blog.metaDescription'>
    <meta expr:content='data:blog.metaDescription' name='description'/>
  <b:else/>
    <meta content='بلاَس | Place-dj — اكتشف الشقق والفلل والمنازل والاستوديوهات في جيبوتي وتواصل مباشرة مع المعلنين.' name='description'/>
  </b:if>

  <!-- NOTE: canonical, og:url, og:title, og:description and og:image are already emitted
       correctly by Blogger's all-head-content. We intentionally do NOT re-declare them here
       to avoid duplicate tags and the empty og:url on post pages. -->
  <meta content='Place-dj' property='og:site_name'/>
  <meta content='ar_DJ' property='og:locale'/>
  <meta content='summary_large_image' name='twitter:card'/>
  <meta expr:content='data:view.title' name='twitter:title'/>
  <b:if cond='data:blog.metaDescription'>
    <meta expr:content='data:blog.metaDescription' name='twitter:description'/>
  <b:else/>
