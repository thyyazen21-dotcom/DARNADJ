  <link href='data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAEAAAABACAYAAACqaXHeAAANK0lEQVR42u2be3Bc9XXHP+f3u3d3Ja0ky0+MIAwEE2OblIBpQimJWupkkmAMAblpaGaSMmXShv6TSSmTPkakk6ZMhzYldWbI5AGdKWSsOKZ4ICXQ[...]' rel='icon'/>
  <link href='data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAALQAAAC0CAYAAAA9zQYyAAAn/0lEQVR42u2deZxcV3Xnv+fe92rpvVuLZVve8IItecELAa9qB2zsAa+4FYZhMZABwjoDSViSCU3iEBMmCYMTQgw2EEICbi+AWIzN0sLYGFsWtuyW[...]' rel='apple-touch-icon'/>
  <b:if cond='data:view.isPost'>
    <meta content='article' property='og:type'/>
  <b:else/>
    <meta content='website' property='og:type'/>
  </b:if>
