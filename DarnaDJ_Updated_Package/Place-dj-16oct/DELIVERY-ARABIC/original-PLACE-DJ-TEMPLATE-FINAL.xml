<!-- ===== Main Content ===== -->
<div class='container'>
  <div class='main-content' id='main-content'>
    <div class='content-area'>

      <b:if cond='data:view.isHomepage'>
        <b:section class='home-before-posts' id='home-before-posts' maxwidgets='2' showaddelement='yes'>
          <b:widget id='HTML8' locked='false' title='مقدمة الصفحة الرئيسية' type='HTML' version='2' visible='true'>
            <b:widget-settings>
              <b:widget-setting name='content'><![CDATA[<section class="home-intro" aria-labelledby="home-intro-title">
                <h1 id="home-intro-title">بلاَس — اعثر على سكنك في جيبوتي</h1>
                <p>اكتشف الشقق والفلل والمنازل والاستوديوهات، واستكشف الخيارات المناسبة لك وتواصل معنا للتحقق من التفاصيل.</p>
              </section>]]></b:widget-setting>
            </b:widget-settings>
            <b:includable id='main'><data:content/></b:includable>
          </b:widget>
        </b:section>
      </b:if>

      <b:if cond='data:view.isHomepage'>
      <b:section class='preferred-section' id='preferred-section' maxwidgets='1' showaddelement='yes'>
        <b:widget id='HTML6' locked='false' title='يفضلها الكثيرون — اختيار تحريري قابل للتعديل' type='HTML' version='2' visible='true'>
          <b:widget-settings>
            <b:widget-setting name='content'><![CDATA[<section class="section preferred-visitors" aria-labelledby="preferred-title">
              <h2 class="section-title" id="preferred-title">مفضلة لدى الضيوف</h2>
              <p class="section-note">أماكن تستحق الاكتشاف — تصفّح عقارات لافتة، واكتشف خيارات جديدة قد تجد بينها مكانك المناسب.</p>
              <div class="preferred-carousel" data-preferred-carousel="1">
                <button aria-label="البطاقات السابقة" class="preferred-nav preferred-prev" type="button">&#8249;</button>
                <div aria-label="عقارات مختارة" class="preferred-viewport" tabindex="0">
                  <div class="preferred-strip">
                    <a class="preferred-card" href="https://www.place-dj.com/2026/10/Beach-villa-rent-djibouti-DJ-VIL-0012.html">
                      <img src="https://lh3.googleusercontent.com/..."/>
                      <span><strong>فيلا شاطئية للإيجار</strong><small>أوبوك · إيجار ليلي · 300 دولار</small></span>
                    </a>
                    <!-- more cards... -->
                  </div>
                </div>
                <button aria-label="البطاقات التالية" class="preferred-nav preferred-next" type="button">&#8250;</button>
              </div>
            </section>]]></b:widget-setting>
          </b:widget-settings>
          <b:includable id='main'><data:content/></b:includable>
        </b:widget>
      </b:section>
      </b:if>

      <!-- Blog1 owns post lists and post-detail structure; this section remains locked by Blogger. -->
      <b:section class='main' id='main-blog' maxwidgets='1' showaddelement='no'>
        <b:widget id='Blog1' locked='true' title='رسائل المدونة الإلكترونية' type='Blog' version='2' visible='true'>
          <b:widget-settings>
            <b:widget-setting name='showDateHeader'>false</b:widget-setting>
            <b:widget-setting name='commentLabel'>comments</b:widget-setting>
            <b:widget-setting name='showShareButtons'>false</b:widget-setting>
            <b:widget-setting name='showCommentLink'>false</b:widget-setting>
            <b:widget-setting name='postLocationLabel'>Location:</b:widget-setting>
            <b:widget-setting name='showAuthor'>false</b:widget-setting>
            <b:widget-setting name='style.unittype'>TextAndImage</b:widget-setting>
            <b:widget-setting name='timestampLabel'>-</b:widget-setting>
            <b:widget-setting name='reactionsLabel'/>
            <b:widget-setting name='showAuthorProfile'>false</b:widget-setting>
            <b:widget-setting name='style.layout'>1x1</b:widget-setting>
            <b:widget-setting name='showLabels'>false</b:widget-setting>
            <b:widget-setting name='showLocation'>false</b:widget-setting>
            <b:widget-setting name='postLabelsLabel'/>
            <b:widget-setting name='showTimestamp'>false</b:widget-setting>
            <b:widget-setting name='postsPerAd'>1</b:widget-setting>
            <b:widget-setting name='showBacklinks'>false</b:widget-setting>
            <b:widget-setting name='showInlineAds'>false</b:widget-setting>
            <b:widget-setting name='showReactions'>false</b:widget-setting>
          </b:widget-settings>
          <b:includable id='main' var='top'>

            <!-- ============ POST DETAIL ============ -->
            <b:if cond='data:view.isPost'>
              <b:loop values='data:posts' var='post'>
                <article class='post property-detail' expr:data-post-id='data:post.id'>
                  <span class='darna-labels' hidden='hidden'>
                    <b:loop values='data:post.labels' var='label'><span class='darna-label'><data:label.name/></span></b:loop>
                  </span>

                  <div class='detail-grid'>
                    <div class='detail-main'>
                      <div class='detail-header'>
                        <h1 class='detail-title'><data:post.title/></h1>
                        <b:if cond='data:post.labels'>
                          <div class='detail-tags'>
                            <b:loop values='data:post.labels' var='label'>
                              <a class='detail-tag darna-label' expr:href='data:label.url'><data:label.name/></a>
                            </b:loop>
                          </div>
                        </b:if>
                      </div>

                      <div class='gallery-container'>
                        <div class='gallery-main' id='gallery-main'>
                          <b:if cond='data:post.featuredImage'>
                            <img expr:alt='data:post.title' expr:src='resizeImage(data:post.featuredImage, 1200, "16:10")' id='gallery-main-img'/>
                          <b:else/>
                            <div id='gallery-main-img' style='height:100%;display:flex;align-items:center;justify-content:center;color:#999;'>لا توجد صور</div>
                          </b:if>
                          <button aria-label='الصورة السابقة' class='gallery-btn prev' type='button'>&#8249;</button>
                          <button aria-label='الصورة التالية' class='gallery-btn next' type='button'>&#8250;</button>
                          <span aria-live='polite' class='gallery-counter' id='gallery-counter'>1/1</span>
                        </div>
                        <div class='gallery-nav' id='gallery-thumbs'/>
                      </div>

                      <div class='detail-specs' id='detail-specs'/>

                      <div class='post-body' id='detail-body'>
                        <data:post.body/>
                      </div>
                      <section aria-labelledby='rating-title' class='property-rating' id='property-rating'>
                        <h2 class='section-title' id='rating-title'>شاركنا رأيك</h2>
                        <p class='rating-status'>لإضافة تعليق أو ملاحظة حول هذا العقار، استخدم قسم التعليقات أدناه.</p>
                        <p><a class='detail-btn' href='#guest-reviews'>اذهب إلى التعليقات</a></p>
                      </section>
                    </div>

                    <aside class='detail-side'>
                      <div class='detail-price-card'>
                        <div class='detail-price' data-darna-price='1' data-lang='ar'><span class='darna-price-value'>&#8230;</span></div>
                        <p class='price-includes'>تشمل الأسعار جميع الرسوم.</p>
                        <div class='detail-status' data-status='unknown'>الحالة غير محددة</div>
                        <span class='detail-type' hidden='hidden'/>
                        <div class='detail-actions'>
                          <button aria-pressed='false' class='detail-btn detail-fav' type='button'><span aria-hidden='true'>&#9829;</span> المفضلة</button>
                          <button aria-pressed='false' class='detail-btn detail-compare' type='button'><span aria-hidden='true'>&#8644;</span> المقارنة</button>
                        </div>

                        <!-- WhatsApp CTA intentionally removed from delivery build; communication instructions provided via inquiry form. -->

                        <form class='inquiry-form' id='inquiry-form' novalidate='novalidate'>
                          <input expr:value='data:post.title' id='inq-property' type='hidden'/>
                          <input expr:value='data:post.url' id='inq-url' type='hidden'/>
                          <div class='field' id='fld-name'>
                            <label for='inq-name'>الاسم <span class='visually-hidden'>(مطلوب)</span></label>
                            <input autocomplete='name' id='inq-name' name='name' type='text' required='required'/>
                            <span class='field-error' id='err-name'/>
                          </div>
                          <div class='field' id='fld-phone'>
                            <label for='inq-phone'>رقم الهاتف <span class='visually-hidden'>(مطلوب)</span></label>
                            <input autocomplete='tel' id='inq-phone' inputmode='tel' name='phone' type='tel' required='required'/>
                            <span class='field-error' id='err-phone'/>
                          </div>
                          <div class='field'>
                            <label for='inq-type'>نوع الطلب</label>
                            <select id='inq-type' name='type'>
                              <option value='استفسار'>استفسار</option>
                              <option value='إيجار'>إيجار</option>
                            </select>
                          </div>
                          <div class='field'>
                            <label for='inq-checkin'>تاريخ الوصول</label>
                            <input id='inq-checkin' name='checkin' type='date'/>
                          </div>
                          <div class='field'>
                            <label for='inq-checkout'>تاريخ المغادرة</label>
                            <input id='inq-checkout' name='checkout' type='date'/>
                          </div>
                          <div class='field'>
                            <label for='inq-guests'>عدد الأشخاص</label>
                            <input id='inq-guests' min='1' name='guests' type='number'/>
                          </div>
                          <div class='field'>
                            <label for='inq-msg'>الرسالة</label>
                            <textarea id='inq-msg' name='message'></textarea>
                          </div>
                          <button class='form-submit' type='submit'>إرسال الطلب</button>
                          <p class='form-note'>يمكنك إرسال طلب الاستفسار وسيتم توجيهه إلى القائمين على الموقع.</p>
                          <div class='form-success' hidden='hidden' id='inq-success'/>
                        </form>
                      </div>
                    </aside>
                  </div>

                  <section class='similar-section' hidden='hidden' id='similar-section'>
                    <h2 class='section-title'>عقارات مشابهة</h2>
                    <div class='property-grid' id='similar-grid'/>
                  </section>

                  <b:if cond='data:post.allowComments'>
                  <section class='comments-section' id='guest-reviews'>
                    <b:if cond='data:post.numberOfComments &gt; 0'>
                      <h2 class='section-title'>آراء الضيوف</h2>
                    <b:else/>
                      <h2 class='section-title'>كن أول من يشارك رأيه</h2>
                    </b:if>
                    <div class='comments-wrap'>
                      <b:include data='post' name='comments'/>
                    </div>
                  </section>
                  </b:if>
                </article>
              </b:loop>

            <!-- ============ STATIC PAGE ============ -->
            <b:elseif cond='data:view.isPage'/>
              <b:loop values='data:posts' var='post'>
                <article class='post'>
                  <h1 class='post-title'><data:post.title/></h1>
                  <div class='post-body'><data:post.body/></div>
                </article>
              </b:loop>

            <!-- ============ LIST (homepage / archive / label / search) ============ -->
            <b:else/>
              <b:if cond='data:view.isHomepage'>
                <section class='section'>
                  <h2 class='section-title'>عقارات مميزة</h2>
                </section>
              <b:else/>
                <section class='section' style='padding-bottom:0;'>
                  <h1 class='section-title'>
                    <b:if cond='data:view.isSearch'>نتائج البحث: <data:blog.searchQuery/>
                    <b:else/><data:blog.pageName/>
                    </b:if>
                  </h1>
                </section>
              </b:if>

</div>
</body>
</html>
