    <script type='application/ld+json'>
    {"@context":"https://schema.org","@type":"BlogPosting","headline":"<data:view.title.jsonEscaped/>","mainEntityOfPage":"<data:blog.homepageUrl/>"}
    </script>
  <b:else/>
