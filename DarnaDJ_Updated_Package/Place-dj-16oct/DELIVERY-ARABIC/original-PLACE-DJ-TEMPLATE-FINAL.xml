  </b:if>
  <b:if cond='data:view.isPost'>
    <b:if cond='data:blog.postImageUrl'>
      <meta expr:content='data:blog.postImageUrl' name='twitter:image'/>
    <b:else/>
      <meta content='https://files.manuscdn.com/user_upload_by_module/session_file/310519664023593322/thGxdOoayXSBCnDX.png' name='twitter:image'/>
    </b:if>
  <b:else/>
    <meta content='https://files.manuscdn.com/user_upload_by_module/session_file/310519664023593322/thGxdOoayXSBCnDX.png' name='twitter:image'/>
  </b:if>
  <meta content='1200' name='twitter:image:width'/>
  <meta content='630' name='twitter:image:height'/>
  <meta content='image/png' name='twitter:image:type'/>
  <meta content='#084a72' name='theme-color'/>
